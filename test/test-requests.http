# api http test requests for VSCode
@apiUrl = http://127.0.0.1:3000/api/v1


### get cats
GET {{apiUrl}}/cats

### get cat by id
GET {{apiUrl}}/cats/1

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

### post new cat
POST {{apiUrl}}/cats
Content-Type: application/json

{
    "name": "three",
    "birthdate": "1010-10-10",
    "weight": 3,
    "owner": "owner",
    "image": "https://placecats.com/310/240"
}

### edit existing cat
PUT {{apiUrl}}/cats/2
Content-Type: application/json

{
    "weight": 22,
    "owner": "new owner"
}

### delete cat by id
DELETE {{apiUrl}}/cats/3

### get remaining cats
GET {{apiUrl}}/cats
